{
  "name": "lets-brew-specialty",
  "account_id": "1aaa91af61ee9076f80653f8a1a554d7",
  "main": "site-worker.mjs",
  "compatibility_date": "2026-10-24",
  "routes": [{"pattern": "letsbrew.djez.app", "custom_domain": true}],
  "workers_dev": false,
  "preview_urls": true,
  "ratelimits": [{"name":"RATE_LIMITER","namespace_id":"430284716","simple":{"limit":10,"period":60}},{"name":"STEM_LIMITER","namespace_id":"430284718","simple":{"limit":40,"period":60}}],
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "observability": {"enabled": true, "head_sampling_rate": 0.1, "redact_query_string": true}
}
