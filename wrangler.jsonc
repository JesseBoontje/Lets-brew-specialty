{
  "name": "lets-brew-specialty",
  "account_id": "1aaa91af61ee9076f80653f8a1a554d7",
  "main": "site-worker.mjs",
  "compatibility_date": "2026-10-24",
  "routes": [{"pattern": "letsbrew.djez.app", "custom_domain": true}],
  "workers_dev": false,
  "preview_urls": true,
  "ratelimits": [{"name":"RATE_LIMITER","namespace_id":"430284716","simple":{"limit":10,"period":60}},{"name":"STEM_LIMITER","namespace_id":"430284718","simple":{"limit":40,"period":60}}],
  "d1_databases": [{"binding":"DB","database_name":"lets-brew","database_id":"b737aed4-ac22-4e08-9c79-d315802777aa","migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"FOTOS","bucket_name":"lets-brew-fotos","jurisdiction":"eu"}],
  "previews": {"r2_buckets": [{"binding":"FOTOS","bucket_name":"lets-brew-fotos-preview","jurisdiction":"eu"}], "d1_databases": [{"binding":"DB","database_name":"lets-brew-preview","database_id":"4f37078c-71e1-4aa1-9837-a37c1ef83dd3","migrations_dir":"migrations"}], "ratelimits": [{"name":"RATE_LIMITER","namespace_id":"430284726","simple":{"limit":10,"period":60}},{"name":"STEM_LIMITER","namespace_id":"430284728","simple":{"limit":40,"period":60}}]},
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "observability": {"enabled": true, "head_sampling_rate": 0.1, "redact_query_string": true}
}
